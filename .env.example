# Copy to .env for local development. Real environment variables take precedence.
# In a deployment, set these as environment variables of the service.

# --- Questlight ---
# Bearer token for Questlight API (10-day TTL; requires PROFILE:CREATE and job permissions).
QUESTLIGHT_TOKEN=
# QUESTLIGHT_BASE_URL=https://dev-api.quest-light.com/api
# QUESTLIGHT_ORIGIN=              # Optional Origin header when tenant enforces domain allowlists
# QUESTLIGHT_ATTACH_RESUME=true   # Attach source file to newly created profiles (falls back to metadata-only on 5xx)
# QUESTLIGHT_BUSINESS_HEAD=       # Business head name/id override for created jobs
# QUESTLIGHT_DEFAULT_CLIENT=      # Fallback client name when omitted by the JD
# MATCHING_BASE_URL=https://dev-api.quest-light.com/matching
# JD_SCREEN_TOP=3                 # Maximum candidates screened per newly created job

# --- Perfox Parser & Notifications ---
PERFOX_API_KEY=                    # API key with documents:extract (and conversations:write if used for WhatsApp replies)
PERFOX_BASE_URL=                   # Workspace API base URL, e.g. https://<workspace>-api.perfox.ai/api/v1
PERFOX_WHATSAPP_FROM=              # Optional E.164 WhatsApp sender number for fill-in form notifications
PERFOX_MESSAGING_KEY=              # Optional dedicated key with conversations:write scope

# --- MCP Server & Agent Webhook ---
# Bearer token checked on POST /mcp (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
MCP_TOKEN=
# MCP_FILE_HOSTS=                 # Comma-separated allowed https hosts for file_url downloads (empty = any https host)

# Webhook trigger connecting the web chat UI (/api/chat) to the Perfox agent
PERFOX_WEBHOOK_URL=
PERFOX_WEBHOOK_SECRET=

# --- Access Control & Limits ---
# Optional HTTP Basic Auth password for web UI and JSON APIs (/mcp uses MCP_TOKEN; /fill/* uses random token)
APP_PASSWORD=
# MASKING_ENABLED=false           # Redact PII fields in responses and request masked PDFs
# PUBLIC_BASE_URL=                # Public origin used when generating /fill/{token} links (empty: relative links, which do not open from a phone: set it in production)
# MAX_UPLOAD_MB=5                 # Max upload size in MB (default 5)
# AUDIT_DB=                       # SQLite path (default data/audit.db inside the app folder: use a persistent volume in production)
