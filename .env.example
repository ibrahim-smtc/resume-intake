# Copy this file to .env and fill it in. .env is git-ignored and is never uploaded to Vercel.
# On Vercel there is no .env file: add the same names under Project > Settings > Environment Variables.
# After changing .env locally, restart the app (Ctrl+C, then python run.py).

# ---------------------------------------------------------------- Questlight
# A Bearer token for Questlight's core API (log in at the Questlight UI, copy it from the browser's Network tab). It lasts
# 10 days. The account needs the PROFILE:CREATE permission. Without it no profile is created and no jobs are read.
QUESTLIGHT_TOKEN=
# QUESTLIGHT_BASE_URL=https://dev-api.quest-light.com/api
# QUESTLIGHT_ORIGIN=              # Origin header to send, if the tenant only accepts requests from its own domain
# QUESTLIGHT_ATTACH_RESUME=true   # false = send the profile without the resume file (no masked CV is made)

# ---------------------------------------------------------------- Which parser reads the resume
# questlight (Questlight's parsing service) or perfox (a temporary stand-in using Perfox's extract_structured).
RESUME_PARSER=questlight
# PARSING_BASE_URL=https://dev-api.quest-light.com/parsing
# Only for RESUME_PARSER=perfox. Needs the documents:extract scope. That workspace belongs to another client: fake resumes only.
PERFOX_API_KEY=
PERFOX_BASE_URL=                # e.g. https://<your-workspace>-api.perfox.ai/api/v1

# ---------------------------------------------------------------- The Perfox agent
# The agent's tools are served at POST /mcp. Every call must send "Authorization: Bearer <MCP_TOKEN>"; register the same
# value in Perfox as the integration's bearer credential. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=
# MCP_FILE_HOSTS=                 # only download resumes from these hosts (comma-separated, subdomains included). Empty = any https host

# The page's text box talks to the agent through its Webhook trigger. PERFOX_WEBHOOK_URL is the trigger's Full URL from
# Perfox Studio and PERFOX_WEBHOOK_SECRET its Auth Secret (Auth Mode must be Shared Secret, or Perfox returns no reply).
# With either missing, the page sends resumes straight into the pipeline instead.
PERFOX_WEBHOOK_URL=
PERFOX_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Protecting the app
# The upload page, the chat/upload APIs and the audit log have no login of their own. Set a password and the browser asks for
# it (HTTP Basic, any user name). Optional: left empty, the pages are open to anyone who has the URL (fine for testing on
# your machine or a test deployment; set it before sharing a deployed link).
APP_PASSWORD=

# ---------------------------------------------------------------- Optional
# MASKING_ENABLED=false           # true = hide email, phone, links and date of birth in what the page and the agent see, and ask Questlight for a masked PDF
# MAX_UPLOAD_MB=5                 # largest resume accepted. Default 5 locally, 4 on Vercel (a function can't receive more than 4.5 MB)
# AUDIT_DB=                       # where the audit log and traces (SQLite) are kept. Default data/audit.db, or /tmp/audit.db on Vercel
